<tr {{ stimulus_controller('quotationLine') }}>
	<td>
		{{ form_row(item_form.itemReference, {
        label: false,
        row_attr: {class: 'mb-1'},
        attr: {
            placeholder: '0',
            'data-action': 'quotationLine#changeProduct',
            'data-quotationLine-target': 'product'
        }
        }) }}
	</td>
    <td>
		{{ form_row(item_form.designation, {
        label: false,
        row_attr: {class: 'mb-1'},
         attr: {
            placeholder: 'saisir une désignation',
            'data-quotationLine-target': 'designation',
             'data-live-ignore': true
        }
        }) }}
	</td>
	<td>
		{{ form_row(item_form.description, {
        label: false,
        row_attr: {class: 'mb-1'},
        attr: {
            placeholder: 'saisir une description',
            'data-quotationLine-target': 'description',
             'data-live-ignore': true
        }
        }) }}
	</td>
	<td>
		{{ form_row(item_form.quantity, {
        label: false,
        row_attr: {class: 'mb-1'},
        attr: {
            placeholder: '0',
            'data-action': 'quotationLine#changeQtty',
            'data-quotationLine-target': 'quantity',
            
        }
        }) }}
	</td>
	<td>
		{{ form_row(item_form.price, {
        label: false,
        row_attr: {class: 'mb-1'},
        attr: {
            placeholder: '0',
            'data-action': 'quotationLine#changePrice',
            'data-quotationLine-target': 'price',
             'data-live-ignore': true
        }
        }) }}
	</td>
	<td>
		{{ form_row(item_form.vat, {
        label: false,
        row_attr: {class: 'mb-1'},
        attr: {
            placeholder: '0',
            'data-action': 'quotationLine#changeVat',
            'data-quotationLine-target': 'vat',
             'data-live-ignore': true
        }
        }) }}
	</td>
	<td >
		{{ form_row(item_form.discount, {
        label: false,
        row_attr: {class: 'mb-1'},
        attr: {
            placeholder: '0',
            'data-action': 'quotationLine#changeDiscount',
            'data-quotationLine-target': 'discount',
           
        }
        }) }}
	</td>
	<td>
		<span data-live-ignore data-quotationLine-target="htPrice" {{ stimulus_target('quotation', 'htPrice') }} data-value=0>0.00</span>
	</td>
	<td>
		<span  data-live-ignore {{ stimulus_target('quotationLine', 'ttcPrice')  }} {{ stimulus_target('quotation', 'ttcPrice') }} data-value="0">0.00</span>
	</td>
	<td>
		{{ form_row(item_form.vars.button_delete,
        {label: 'X', attr: {
            class: 'btn btn-outline-danger',
            'data-action': 'quotation#updatePrice live#action',
            }
        }) }}
        </div>
	</td>
</tr>
