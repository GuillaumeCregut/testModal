<div{{ attributes }}>
    {{ form_start(form) }}
    <div class="quotation-info">
        {{ form_row(form.quotationId, {
                    label: 'Référence du devis',
                    value: 'something'
                })
        }}
    </div>
    <div class="quotation-line-container">
        <table class="quotation-line"  {{ stimulus_controller('quotation') }}>
            <thead>
                <tr>
                    <th>Référence produit</th>
                    <th>Désignation</th>
                    <th>Description</th>
                    <th>Quantité</th>
                    <th>Prix</th>
                    <th>TVA</th>
                    <th>Remise</th>
                    <th>Total HT</th>
                    <th>Total TTC</th>
                </tr>
            </thead>
            <tbody>
                {% for item_form in form.quotationLines %}
                     {{ include('quotations/_quotationLine.hml.twig', {item_form: item_form}) }}
                {% endfor %}
            </tbody>
            <tfoot>
                <tr  data-action= "quotationLine:updated@window->quotation#updatePrice">
                    <td colspan="7">Total </td>
                    <td><span  data-live-ignore {{ stimulus_target('quotation', 'htTotalPrice') }} >0.00</span></td>
                    <td><span  data-live-ignore {{ stimulus_target('quotation', 'ttcTotalPrice') }}>0.00</span></td>
                </tr>
            </tfoot>
        </table>
         {{ form_widget(form.quotationLines.vars.button_add,{
        label: 'Ajouter un item',
        attr: {class: 'btn btn-primary'}
    }) }}
    </div>
    <button class="btn btn-success" type="submit" formnovalidate>Enregistrer</button>
        {{ form_end(form) }}
</div>
