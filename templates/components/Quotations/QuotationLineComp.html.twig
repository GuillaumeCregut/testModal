<tr {{ attributes }}>
	<td>
		{{ form_row(item_form.itemReference, {
        label: false,
        row_attr: {class: 'mb-1'},
        }) }}
	</td>
	<td>
		{{ form_row(item_form.description, {
        label: false,
        row_attr: {class: 'mb-1'},
        attr: {
            placeholder: 'Ajoute un truc'
        }
        }) }}
	</td>
	<td>
		{{ form_row(item_form.quantity, {
        label: false,
        row_attr: {class: 'mb-1'},
        attr: {
            placeholder: 'Ajoute un truc'
        }
        }) }}
	</td>
	<td>
		{{ form_row(item_form.price, {
        label: false,
        row_attr: {class: 'mb-1'},
        attr: {
            placeholder: 'Ajoute un truc'
        }
        }) }}
	</td>
	<td>
		{{ form_row(item_form.vat, {
        label: false,
        row_attr: {class: 'mb-1'},
        attr: {
            placeholder: 'Ajoute un truc'
        }
        }) }}
	</td>
	<td>
		{{ form_row(item_form.discount, {
        label: false,
        row_attr: {class: 'mb-1'},
        attr: {
            placeholder: 'Ajoute un truc'
        }
        }) }}
	</td>
	<td>
		Total
	</td>
	<td>
		Total TTC
	</td>
	<td>
		{{ form_row(item_form.vars.button_delete,{label: 'X', attr: {class: 'btn btn-outline-danger'}}) }}
	</td>
</tr>
